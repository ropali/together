# Add credentials issued by a TURN provider. Do not commit real credentials.
# A TURN service is required for peers behind NATs/firewalls that block direct ICE.
VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_USERNAME=replace-with-short-lived-username
VITE_TURN_CREDENTIAL=replace-with-short-lived-credential
